{
  "$meta": {
    "name": "corn-ui-tokens",
    "version": "0.1.0",
    "description": "Corn UI design tokens — 纸田青釉 × 墨绿 × 玉米黄。跨端单一来源：corn-tokens.css 由 scripts/build.py 从本文件生成。",
    "sources": ["CornStudio Theme.swift (Hull)", "玉米 AI 官网 styles.css"],
    "naming": "flat 组（color/font/motion/layout）→ --corn-<key>；scaled 组（radius/space）→ --corn-<group>-<key>；theme.* → 语义变量 --corn-<key>，值里 {group.key} 是引用。"
  },
  "color": {
    "void": "#f6f7ef",
    "paper": "#f2f3e9",
    "panel": "#e8eade",
    "paper-3": "#dbdecb",
    "raised": "#fafbf5",
    "panel-hover": "#e3e5d6",
    "ink-deep": "#141713",
    "ink": "#1b1e1a",
    "ink-2": "#252922",
    "ink-3": "#32372c",
    "muted": "#58635a",
    "muted-2": "#5f6a61",
    "ondark-muted": "#aeb9ae",
    "ondark-subtle": "#9aa59b",
    "control-line": "#7d877e",
    "ondark-control-line": "#858d84",
    "maize": "#f2c84b",
    "maize-hover": "#f5d26a",
    "maize-soft": "#f7de96",
    "maize-deep": "#7a560c",
    "husk": "#4d6847",
    "husk-deep": "#34482f",
    "sage": "#7e9a72",
    "celadon": "#a9bc9c",
    "danger": "#ad342c",
    "alert": "#fa5c57"
  },
  "font": {
    "serif": "\"Songti SC\", \"Noto Serif SC\", \"Source Han Serif SC\", \"STSong\", \"SimSun\", serif",
    "sans": "\"PingFang SC\", \"Hiragino Sans GB\", \"Noto Sans SC\", \"Microsoft YaHei\", system-ui, -apple-system, sans-serif",
    "mono": "\"SF Mono\", \"JetBrains Mono\", \"IBM Plex Mono\", ui-monospace, Menlo, Consolas, monospace"
  },
  "radius": { "xs": "2px", "sm": "3px", "md": "4px", "lg": "9px" },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px", "6": "32px", "7": "48px", "8": "64px" },
  "motion": {
    "ease": "cubic-bezier(0.22, 0.61, 0.36, 1)",
    "ease-out": "cubic-bezier(0.16, 1, 0.3, 1)",
    "ease-in": "cubic-bezier(0.55, 0, 0.75, 0.2)",
    "dur-fast": "0.12s",
    "dur": "0.2s",
    "dur-slow": "0.55s",
    "stagger": "60ms"
  },
  "layout": { "shell": "1280px", "gutter": "clamp(20px, 4.2vw, 56px)" },
  "alias": {
    "radius": "{radius.md}",
    "line": "{theme.border}",
    "line-strong": "{theme.border-strong}"
  },
  "theme": {
    "light": {
      "bg": "{color.paper}",
      "bg-subtle": "{color.void}",
      "surface": "{color.panel}",
      "surface-raised": "{color.raised}",
      "surface-sunken": "{color.paper-3}",
      "surface-hover": "{color.panel-hover}",
      "fg": "{color.ink}",
      "fg-muted": "{color.muted}",
      "fg-subtle": "{color.muted-2}",
      "border": "rgba(27, 30, 26, 0.14)",
      "border-strong": "rgba(27, 30, 26, 0.3)",
      "control-border": "{color.control-line}",
      "solid-bg": "{color.ink}",
      "solid-hover": "{color.ink-3}",
      "solid-fg": "{color.paper}",
      "accent": "{color.maize}",
      "accent-hover": "{color.maize-hover}",
      "accent-fg": "{color.ink}",
      "accent-text": "{color.maize-deep}",
      "accent-soft": "{color.maize-soft}",
      "brand": "{color.husk}",
      "brand-hover": "{color.husk-deep}",
      "brand-fg": "{color.paper}",
      "brand-text": "{color.husk}",
      "brand-soft": "rgba(77, 104, 71, 0.12)",
      "danger-text": "{color.danger}",
      "danger-soft": "rgba(173, 52, 44, 0.09)",
      "danger-border": "{color.danger}",
      "focus": "{color.maize-deep}",
      "focus-glow": "rgba(242, 200, 75, 0.35)",
      "selection": "{color.maize}",
      "code-bg": "{color.ink}",
      "code-fg": "{color.paper}",
      "code-accent": "{color.maize-soft}",
      "overlay": "rgba(27, 30, 26, 0.42)",
      "shadow-sm": "0 1px 2px rgba(27, 30, 26, 0.1)",
      "shadow-card": "0 0 0 1px rgba(27, 30, 26, 0.02), 0 6px 14px -10px rgba(27, 30, 26, 0.5)",
      "shadow-card-hover": "0 0 0 1px rgba(242, 200, 75, 0.6), 0 10px 22px -12px rgba(27, 30, 26, 0.6)",
      "shadow-pop": "0 1px 0 rgba(27, 30, 26, 0.04), 0 18px 40px -18px rgba(27, 30, 26, 0.55)",
      "skeleton": "rgba(27, 30, 26, 0.07)",
      "skeleton-shine": "rgba(250, 251, 245, 0.8)"
    },
    "dark": {
      "bg": "{color.ink}",
      "bg-subtle": "{color.ink}",
      "surface": "{color.ink-2}",
      "surface-raised": "{color.ink-2}",
      "surface-sunken": "{color.ink}",
      "surface-hover": "{color.ink-3}",
      "fg": "{color.paper}",
      "fg-muted": "{color.ondark-muted}",
      "fg-subtle": "{color.ondark-subtle}",
      "border": "rgba(242, 243, 233, 0.16)",
      "border-strong": "rgba(242, 243, 233, 0.32)",
      "control-border": "{color.ondark-control-line}",
      "solid-bg": "{color.paper}",
      "solid-hover": "{color.raised}",
      "solid-fg": "{color.ink}",
      "accent": "{color.maize}",
      "accent-hover": "{color.maize-hover}",
      "accent-fg": "{color.ink}",
      "accent-text": "{color.maize}",
      "accent-soft": "rgba(242, 200, 75, 0.16)",
      "brand": "{color.husk}",
      "brand-hover": "{color.husk-deep}",
      "brand-fg": "{color.paper}",
      "brand-text": "{color.celadon}",
      "brand-soft": "rgba(169, 188, 156, 0.14)",
      "danger-text": "{color.alert}",
      "danger-soft": "rgba(250, 92, 87, 0.12)",
      "danger-border": "{color.alert}",
      "focus": "{color.maize}",
      "focus-glow": "rgba(242, 200, 75, 0.28)",
      "selection": "{color.maize}",
      "code-bg": "{color.ink-deep}",
      "code-fg": "{color.paper}",
      "code-accent": "{color.maize-soft}",
      "overlay": "rgba(10, 12, 10, 0.6)",
      "shadow-sm": "0 1px 2px rgba(0, 0, 0, 0.3)",
      "shadow-card": "0 0 0 1px rgba(242, 243, 233, 0.04)",
      "shadow-card-hover": "0 0 0 1px rgba(242, 200, 75, 0.55), 0 12px 26px -14px rgba(0, 0, 0, 0.7)",
      "shadow-pop": "0 0 0 1px rgba(242, 243, 233, 0.08), 0 20px 44px -18px rgba(0, 0, 0, 0.8)",
      "skeleton": "rgba(242, 243, 233, 0.08)",
      "skeleton-shine": "rgba(242, 243, 233, 0.12)"
    }
  }
}
