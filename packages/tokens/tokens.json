{
  "$meta": {
    "name": "corn-ui-tokens",
    "version": "0.0.1",
    "description": "Corn UI design tokens — 纸田青釉 × 墨绿 × 玉米黄。跨端单一来源。",
    "sources": ["CornStudio Theme.swift (Hull)", "玉米 AI 官网 styles.css"]
  },
  "color": {
    "surface": {
      "void": "#f6f7ef",
      "paper": "#f2f3e9",
      "panel": "#e8eade",
      "paper3": "#dbdecb",
      "raised": "#fafbf5",
      "preview": "#cfd6c7"
    },
    "ink": {
      "default": "#1b1e1a",
      "2": "#252922",
      "3": "#32372c",
      "muted": "#58635a",
      "muted2": "#7a857c",
      "ondarkMuted": "#aeb9ae"
    },
    "brand": {
      "maize": "#f2c84b",
      "maizeSoft": "#f7de96",
      "maizeDeep": "#8a6110",
      "husk": "#4d6847",
      "huskDeep": "#34482f",
      "sage": "#7e9a72",
      "celadon": "#a9bc9c"
    },
    "semantic": {
      "danger": "#ad342c",
      "alert": "#fa5c57"
    },
    "line": {
      "default": "rgba(27,30,26,0.14)",
      "strong": "rgba(27,30,26,0.3)",
      "ink": "rgba(242,243,233,0.16)",
      "inkStrong": "rgba(242,243,233,0.32)"
    }
  },
  "font": {
    "serif": "Songti SC, Noto Serif SC, Source Han Serif SC, STSong, SimSun, serif",
    "sans": "PingFang SC, Hiragino Sans GB, Noto Sans SC, Microsoft YaHei, system-ui, -apple-system, sans-serif",
    "mono": "SF Mono, JetBrains Mono, IBM Plex Mono, ui-monospace, Menlo, Consolas, monospace"
  },
  "radius": { "xs": 2, "sm": 3, "md": 4, "lg": 9 },
  "motion": {
    "ease": "cubic-bezier(0.22,0.61,0.36,1)",
    "dur": "0.2s",
    "durSlow": "0.55s"
  },
  "layout": { "shell": 1280, "gutter": "clamp(20px,4.2vw,56px)" }
}
