{
  "name": "@corn-ui/css",
  "version": "0.1.0",
  "private": true,
  "description": "Corn UI component layer: corn.css + optional corn.js (generated from src/ and components/<name>/)",
  "files": ["corn.css", "corn.js", "src/", "components/"],
  "exports": {
    ".": "./corn.css",
    "./css": "./corn.css",
    "./js": "./corn.js",
    "./components/*": "./components/*"
  },
  "dependencies": {
    "@corn-ui/tokens": "workspace:*"
  }
}
